pipeline {
    agent any

    environment {
        POSTGRES_SECRET = credentials('jenkins-postgres-credentials')
    }

    stages {
        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Parquet DQ tests') {
            steps {
                dir('PyTest DQ Framework') {
                    sh 'mkdir -p html_report'

                    sh '''
                        .venv/bin/python -m pytest tests -m "parquet_data" \
                            --db_host="postgres" \
                            --db_port="5432" \
                            --db_name="mydatabase" \
                            --db_user="$POSTGRES_SECRET_USR" \
                            --db_password="$POSTGRES_SECRET_PSW" \
                            --html=html_report/report.html \
                            --self-contained-html
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('PyTest DQ Framework') {
                archiveArtifacts(
                    artifacts: 'html_report/**',
                    allowEmptyArchive: true
                )

                publishHTML(target: [
                    allowMissing: true,
                    keepAll: true,
                    reportDir: 'html_report',
                    reportFiles: 'report.html',
                    reportName: 'HTML Test Report'
                ])
            }
        }
    }
}